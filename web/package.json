{
  "name": "esp-ble-sdk",
  "version": "0.1.0-beta.3",
  "description": "A typed TypeScript SDK for talking to ESP32 devices over Web Bluetooth, with a matching Arduino/ESP-IDF firmware library and npm library.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "firmware"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naseem-shawarba/esp-ble-sdk.git",
    "directory": "web"
  },
  "scripts": {
    "build": "tsc",
    "prepack": "cp ../README.md .",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/web-bluetooth": "^0.0.20",
    "@types/react": "^18.2.0"
  },
  "license": "MIT",
  "keywords": [
    "esp32",
    "bluetooth",
    "web-bluetooth",
    "ble",
    "iot",
    "arduino"
  ]
}
